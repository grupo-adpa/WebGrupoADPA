{
  "name": "web-grupo-adpa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check:dist": "node scripts/check-dist.mjs",
    "lighthouse": "lhci autorun",
    "audit:dev": "node scripts/audit-dev.mjs",
    "test:policy": "node --test scripts/tests/*.test.mjs",
    "test:publication": "node scripts/test-publication-build.mjs",
    "test:invue-build": "node scripts/test-invue-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "lucide": "1.73.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "eslint": "10.14.0",
    "parse5": "8.1.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "minimatch": "11.0.8",
    "basic-ftp": "6.2.6"
  }
}
